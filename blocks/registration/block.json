{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpac/registration",
	"title": "Partner application form",
	"category": "widgets",
	"icon": "groups",
	"description": "Application form for your partner program.",
	"textdomain": "affiliate-captain",
	"attributes": {
		"group": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [
		"postId"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "wpac-blocks"
}
