msgstr "Belegordner ist nicht öffentlich erreichbar"

msgid "Connections"
msgstr "Verbindungen"

msgid "System status"
msgstr "Systemstatus"

msgid "Retry queue"
msgstr "Wiederholungs-Warteschlange"

msgid "Integration sections"
msgstr "Bereiche der Integrationen"

