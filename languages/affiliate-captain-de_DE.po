msgstr "Hallo %1$s,\n\nwir haben die Gutschrift %2$s mit dem angehängten Stornobeleg %3$s storniert. Die Provisionen bleiben in deinem Konto und werden mit einer neuen Gutschrift ausgezahlt.\n\nPartnerbereich: %4$s"

msgid "[%1$s] Correction credit note %2$s for credit note %3$s"
msgstr "[%1$s] Korrekturgutschrift %2$s zur Gutschrift %3$s"

msgid "Hello %1$s,\n\nwe have corrected credit note %2$s with the attached correction credit note %3$s. %4$s\n\nPartner area: %5$s"
msgstr "Hallo %1$s,\n\nwir haben die Gutschrift %2$s mit der beigefügten Korrekturgutschrift %3$s korrigiert. %4$s\n\nPartnerbereich: %5$s"

msgid "[%s] Your bank details were changed"
