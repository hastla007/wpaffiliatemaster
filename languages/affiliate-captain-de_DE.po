msgstr "Hallo %1$s,\n\nwir haben %2$s auf dein Konto überwiesen (Gutschrift %3$s).\n\nDie Gutschrift kannst du in deinem Partnerbereich herunterladen: %4$s"

msgid "[%1$s] Payout %2$s paid"
msgstr "[%1$s] Auszahlung %2$s bezahlt"

msgid "Hello %1$s,\n\nwe have paid out %2$s to you with the payment method agreed with you (credit note %3$s).\n\nYou can download the credit note in your partner area: %4$s"
msgstr "Hallo %1$s,\n\nwir haben dir %2$s über die mit dir vereinbarte Zahlungsart ausgezahlt (Gutschrift %3$s).\n\nDie Gutschrift kannst du in deinem Partnerbereich herunterladen: %4$s"

msgid "[%1$s] Credit note %2$s"
