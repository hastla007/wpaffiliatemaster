msgstr[1] "%d ausgewählte Partner wurden übersprungen, da sie keine offenen Bewerbungen sind."

msgid "%d active partner has not accepted the current partner terms yet; credit notes cannot be issued to them."
msgid_plural "%d active partners have not accepted the current partner terms yet; credit notes cannot be issued to them."
